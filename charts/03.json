{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": null,
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "DM Sans",
      "titleFont": "DM Sans",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "labelColor": "#45615c",
      "titleColor": "#183d3c",
      "gridColor": "#e3eae5",
      "tickColor": "#cedbd2",
      "domain": false,
      "labelPadding": 6,
      "titlePadding": 10
    },
    "legend": {
      "labelFont": "DM Sans",
      "titleFont": "DM Sans",
      "labelFontSize": 10,
      "titleFontSize": 11,
      "labelColor": "#45615c",
      "orient": "bottom"
    },
    "title": {
      "font": "Fraunces",
      "fontSize": 16,
      "color": "#163f42"
    },
    "font": "DM Sans",
    "background": null
  },
  "width": 485,
  "height": 380,
  "data": {
    "url": "data/dorling_cartogram.csv"
  },
  "layer": [
    {
      "mark": {
        "type": "circle",
        "stroke": "#ffffff",
        "strokeWidth": 2,
        "opacity": 0.93
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              500
            ]
          },
          "axis": null
        },
        "y": {
          "field": "y",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              440
            ],
            "reverse": true
          },
          "axis": null
        },
        "size": {
          "field": "stores",
          "type": "quantitative",
          "title": "Coles + Woolworths stores",
          "scale": {
            "type": "linear",
            "domain": [
              0,
              606
            ],
            "range": [
              0,
              8500
            ]
          },
          "legend": {
            "title": "Two-chain outlets (area)",
            "values": [
              20,
              125,
              350,
              600
            ]
          }
        },
        "color": {
          "field": "wool_share",
          "type": "quantitative",
          "title": "Woolworths share of the two (%)",
          "scale": {
            "domain": [
              50,
              66
            ],
            "range": [
              "#d1ece1",
              "#0d5867"
            ],
            "clamp": true
          },
          "legend": {
            "title": "Woolworths share (%)"
          }
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "stores",
            "type": "quantitative",
            "title": "Two-chain stores"
          },
          {
            "field": "woolworths",
            "type": "quantitative",
            "title": "Woolworths"
          },
          {
            "field": "coles",
            "type": "quantitative",
            "title": "Coles"
          },
          {
            "field": "wool_share",
            "type": "quantitative",
            "title": "Woolworths proportion (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "font": "DM Sans",
        "fontSize": 11,
        "fontWeight": "bold",
        "baseline": "middle"
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              500
            ]
          },
          "axis": null
        },
        "y": {
          "field": "y",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              440
            ],
            "reverse": true
          },
          "axis": null
        },
        "text": {
          "field": "code",
          "type": "nominal"
        },
        "color": {
          "condition": {
            "test": "datum.wool_share>=58",
            "value": "#ffffff"
          },
          "value": "#123B41"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "font": "DM Sans",
        "fontSize": 10,
        "fontWeight": "bold",
        "dy": 15
      },
      "transform": [
        {
          "filter": "datum.stores >= 100"
        }
      ],
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              500
            ]
          },
          "axis": null
        },
        "y": {
          "field": "y",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              440
            ],
            "reverse": true
          },
          "axis": null
        },
        "text": {
          "field": "stores",
          "type": "quantitative",
          "format": ",.0f"
        },
        "color": {
          "condition": {
            "test": "datum.wool_share>=58",
            "value": "#ffffff"
          },
          "value": "#133B41"
        }
      }
    }
  ],
  "description": "Valid manually arranged circle cartogram: geographic polygons are replaced with non-overlapping sized circles. A schematic, not an automatic Dorling algorithm."
}
